# Supabase — enables login + shared data across devices (realtime).
# Without these, the app runs in localStorage mode (single browser only).
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only (never NEXT_PUBLIC_): lets parents create kid logins via /api/members.
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
